# ============================================================
# IMPORTS
# ============================================================

import os
import re
import numpy as np
import faiss
import gradio as gr

from pypdf import PdfReader
from sentence_transformers import SentenceTransformer
from groq import Groq


# ============================================================
# CONFIG
# ============================================================

MODEL = "openai/gpt-oss-20b"
EMBEDDING_MODEL = "sentence-transformers/all-MiniLM-L6-v2"

CHUNK_SIZE = 900
CHUNK_OVERLAP = 150
TOP_K = 5


# ============================================================
# GLOBAL VARIABLES
# ============================================================

embedding_model = None
vector_database = None
document_chunks = []


# ============================================================
# LOAD EMBEDDING MODEL
# ============================================================

print("Loading embedding model...")

embedding_model = SentenceTransformer(
    EMBEDDING_MODEL
)

print("Embedding model loaded.")


# ============================================================
# CLEAN TEXT
# ============================================================

def clean_text(text):

    if not text:
        return ""

    text = re.sub(r"\s+", " ", text)

    return text.strip()


# ============================================================
# CHUNK TEXT
# ============================================================

def split_text(
    text,
    chunk_size=CHUNK_SIZE,
    overlap=CHUNK_OVERLAP
):

    text = clean_text(text)

    if not text:
        return []

    chunks = []

    start = 0

    while start < len(text):

        end = min(
            start + chunk_size,
            len(text)
        )

        chunk = text[start:end]

        if end < len(text):

            last_space = chunk.rfind(" ")

            if last_space > chunk_size * 0.6:

                chunk = chunk[:last_space]

                end = start + len(chunk)

        chunks.append(
            chunk.strip()
        )

        next_start = end - overlap

        if next_start <= start:

            next_start = end

        start = next_start

    return chunks


# ============================================================
# READ PDF
# ============================================================

def read_pdf(file_path):

    reader = PdfReader(file_path)

    pages = []

    for page_number, page in enumerate(
        reader.pages,
        start=1
    ):

        try:

            text = page.extract_text()

        except Exception:

            text = ""

        text = clean_text(text)

        if text:

            pages.append({
                "text": text,
                "page": page_number,
                "source": os.path.basename(
                    file_path
                )
            })

    return pages


# ============================================================
# BUILD KNOWLEDGE BASE
# ============================================================

def build_knowledge_base(files):

    global vector_database
    global document_chunks

    if not files:

        return "⚠️ Please upload at least one PDF."

    document_chunks = []

    total_pages = 0

    for file_path in files:

        try:

            pages = read_pdf(
                file_path
            )

            total_pages += len(pages)

            for page in pages:

                chunks = split_text(
                    page["text"]
                )

                for chunk in chunks:

                    document_chunks.append({

                        "text": chunk,

                        "source": page["source"],

                        "page": page["page"]

                    })

        except Exception as e:

            print(
                "PDF error:",
                e
            )

    if not document_chunks:

        return (
            "❌ No readable text was found "
            "in the PDFs."
        )

    print(
        f"Creating embeddings for "
        f"{len(document_chunks)} chunks..."
    )

    texts = [
        item["text"]
        for item in document_chunks
    ]

    embeddings = embedding_model.encode(

        texts,

        convert_to_numpy=True,

        normalize_embeddings=True,

        show_progress_bar=True

    )

    embeddings = embeddings.astype(
        "float32"
    )

    dimension = embeddings.shape[1]

    vector_database = faiss.IndexFlatIP(
        dimension
    )

    vector_database.add(
        embeddings
    )

    print("FAISS database ready.")

    return (
        "## ✅ Knowledge Base Ready\n\n"
        f"📄 Documents: {len(files)}\n\n"
        f"📑 Pages: {total_pages}\n\n"
        f"🧩 Chunks: {len(document_chunks)}\n\n"
        "You can now ask questions."
    )


# ============================================================
# RETRIEVE
# ============================================================

def retrieve(question):

    if vector_database is None:

        return []

    query_embedding = embedding_model.encode(

        [question],

        convert_to_numpy=True,

        normalize_embeddings=True

    )

    query_embedding = query_embedding.astype(
        "float32"
    )

    k = min(
        TOP_K,
        len(document_chunks)
    )

    scores, indices = vector_database.search(

        query_embedding,

        k

    )

    results = []

    for score, index in zip(
        scores[0],
        indices[0]
    ):

        if index < 0:
            continue

        result = document_chunks[
            index
        ].copy()

        result["score"] = float(
            score
        )

        results.append(
            result
        )

    return results


# ============================================================
# CONTEXT
# ============================================================

def make_context(results):

    if not results:

        return "No relevant context found."

    context = ""

    for i, result in enumerate(
        results,
        start=1
    ):

        context += f"""

SOURCE {i}

Document: {result['source']}

Page: {result['page']}

Content:

{result['text']}

-----------------------------
"""

    return context


# ============================================================
# GROQ
# ============================================================

def ask_groq(

    question,

    history,

    api_key,

    temperature,

    reasoning

):

    if not api_key:

        return (
            "⚠️ Please enter your Groq API key."
        )

    if vector_database is None:

        return (
            "⚠️ Please upload PDFs and "
            "build the knowledge base first."
        )

    try:

        client = Groq(
            api_key=api_key.strip()
        )

        # --------------------------------------------------------
        # RAG RETRIEVAL
        # --------------------------------------------------------

        results = retrieve(
            question
        )

        context = make_context(
            results
        )

        # --------------------------------------------------------
        # SYSTEM PROMPT
        # --------------------------------------------------------

        system_prompt = f"""
You are a RAG-based AI assistant.

Answer the user's question using the
retrieved document context.

RULES:

- Use the documents as your primary source.
- Never invent facts.
- If the information cannot be found
  in the documents, clearly say so.
- Give concise but useful answers.
- Mention document names and page numbers
  when appropriate.

RETRIEVED CONTEXT:

{context}
"""

        messages = [

            {
                "role": "system",
                "content": system_prompt
            }

        ]

        # --------------------------------------------------------
        # ADD HISTORY
        # --------------------------------------------------------

        if history:

            for item in history:

                if isinstance(
                    item,
                    (list, tuple)
                ):

                    if len(item) >= 1:

                        if item[0]:

                            messages.append({

                                "role": "user",

                                "content": str(
                                    item[0]
                                )

                            })

                    if len(item) >= 2:

                        if item[1]:

                            messages.append({

                                "role": "assistant",

                                "content": str(
                                    item[1]
                                )

                            })

        messages.append({

            "role": "user",

            "content": question

        })

        # --------------------------------------------------------
        # GROQ API
        # --------------------------------------------------------

        response = client.chat.completions.create(

            model=MODEL,

            messages=messages,

            temperature=float(
                temperature
            ),

            reasoning_effort=reasoning,

            max_completion_tokens=4096

        )

        answer = (
            response
            .choices[0]
            .message
            .content
        )

        # --------------------------------------------------------
        # SOURCES
        # --------------------------------------------------------

        if results:

            answer += (
                "\n\n### 📚 Sources\n"
            )

            used = set()

            for result in results:

                key = (
                    result["source"],
                    result["page"]
                )

                if key in used:

                    continue

                used.add(key)

                answer += (

                    f"- {result['source']} "
                    f"(Page {result['page']})\n"

                )

        return answer

    except Exception as e:

        return (
            "❌ Error from Groq:\n\n"
            + str(e)
        )


# ============================================================
# CHAT FUNCTION
# ============================================================

def respond(

    message,

    history,

    api_key,

    temperature,

    reasoning

):

    if not message:

        return history, ""

    answer = ask_groq(

        message,

        history,

        api_key,

        temperature,

        reasoning

    )

    if history is None:

        history = []

    history.append(
        [message, answer]
    )

    return history, ""


